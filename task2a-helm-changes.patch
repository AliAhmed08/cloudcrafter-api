@@ -0,0 +1,30 @@
+{{- if .Values.ingress.enabled }}
+apiVersion: networking.k8s.io/v1
+kind: Ingress
+metadata:
+  name: cloudcrafter-ingress
+  {{- with (include "cloudcrafter.namespace" .) }}
+  namespace: {{ . }}
+  {{- end }}
+  labels:
+    {{- include "cloudcrafter.labels" . | nindent 4 }}
+  {{- with .Values.ingress.annotations }}
+  annotations:
+    {{- toYaml . | nindent 4 }}
+  {{- end }}
+spec:
+  ingressClassName: {{ .Values.ingress.className }}
+  rules:
+    - host: {{ .Values.ingress.host }}
+      http:
+        paths:
+          {{- range $name, $svc := .Values.services }}
+          - path: {{ printf "%s(/|$)(.*)" $svc.apiPath }}
+            pathType: ImplementationSpecific
+            backend:
+              service:
+                name: {{ include "cloudcrafter.serviceFullname" (dict "name" $name) }}
+                port:
+                  number: {{ $svc.servicePort }}
+          {{- end }}
+{{- end }}
