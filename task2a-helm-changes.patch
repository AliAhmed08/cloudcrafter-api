-+++ b/localstack/docker-compose.yml
-@@ -0,0 +1,40 @@
-+version: "3.8"
-+
-+# CloudCrafter Task 1 — LocalStack environment.
-+# Provides S3 (ticket receipt bucket) and Lambda (event-driven notification trigger).
-+#
-+# Run from the localstack/ directory:
-+#   docker compose up -d
-+#
-+# LocalStack is started OUTSIDE the Kubernetes cluster (plain Docker), because
-+# LocalStack Community does not run well as a Kubernetes workload for local dev.
-+# See README.md "Networking: LocalStack <-> Kubernetes" for how Lambda reaches
-+# the notifications Service running inside Minikube.
-+
-+services:
-+  localstack:
-+    container_name: cloudcrafter-localstack
-+    image: localstack/localstack:3.4
-+    ports:
-+      - "4566:4566" # LocalStack edge port (S3, Lambda, IAM, etc. all multiplexed here)
-+    environment:
-+      - SERVICES=s3,lambda,iam,sts,logs,cloudwatch
-+      - DEBUG=0
-+      - LAMBDA_EXECUTOR=docker
