diff --git a/charts/cloudcrafter/templates/tickets-s3-secret.yaml b/charts/cloudcrafter/templates/tickets-s3-secret.yaml
new file mode 100644
index 0000000..ba5ab8f
--- /dev/null
+++ b/charts/cloudcrafter/templates/tickets-s3-secret.yaml
@@ -0,0 +1,30 @@
+{{/*
+Holds the S3 access key / secret key for the Tickets service.
+
+IMPORTANT: the default values (values.yaml s3.accessKeyId / s3.secretAccessKey)
+are LocalStack's well-known, publicly documented dummy credentials
+("test"/"test") — they are not sensitive and authenticate against nothing
+outside a local LocalStack instance. They are still routed through a Secret
+(rather than a plain env value on the Deployment) as the correct pattern for
+*how* credentials should flow into a container, so that pointing this same
+chart at a real AWS account later only requires overriding these values
+(via --set or a non-committed values file) — never editing this template.
+Real AWS credentials must NEVER be set as literal values in a committed
+values.yaml, the same rule that applies to the JWT keys (see jwt.existingSecret).
+*/}}
+{{- if (index .Values.services "tickets").s3Env }}
+apiVersion: v1
+kind: Secret
+metadata:
+  name: {{ include "cloudcrafter.serviceFullname" (dict "name" "tickets") }}-s3-credentials
+  {{- with (include "cloudcrafter.namespace" .) }}
+  namespace: {{ . }}
+  {{- end }}
+  labels:
+    {{- include "cloudcrafter.selectorLabels" (dict "name" "tickets") | nindent 4 }}
+    {{- include "cloudcrafter.labels" . | nindent 4 }}
+type: Opaque
+stringData:
+  accessKeyId: {{ .Values.s3.accessKeyId | quote }}
+  secretAccessKey: {{ .Values.s3.secretAccessKey | quote }}
+{{- end }}
diff --git a/charts/cloudcrafter/values.yaml b/charts/cloudcrafter/values.yaml
new file mode 100644
index 0000000..b970357
--- /dev/null
+++ b/charts/cloudcrafter/values.yaml
@@ -0,0 +1,201 @@
+# Default values for the cloudcrafter chart.
+# Tuned for local Minikube out of the box. Override any of this with
+# -f values-<env>.yaml or --set for other environments (later Task 2 steps).
+
+global:
+  # Left empty on purpose: when unset, every resource is created in whatever
+  # namespace `helm install -n <namespace>` targets (Helm/kubectl's normal
+  # behavior). This chart intentionally does NOT hardcode a namespace name
+  # anywhere, so the identical chart can later be installed into `aws` and
+  # `google-cloud` namespaces (Task 2, later step) just by changing the
+  # `-n`/`--namespace` flag at install time — no template or values change
+  # needed for that alone.
+  namespaceOverride: ""
+
+  # Applied to every resource this chart creates, in addition to the
+  # standard Helm labels from _helpers.tpl. Use this for environment tags
+  # (e.g. cloud: aws) once multi-environment deploys are implemented — left
+  # empty here since Task 2A doesn't implement that yet.
+  extraLabels: {}
+
+imagePullPolicy: IfNotPresent
+
+# ------------------------------------------------------------------------
+# Ingress — mirrors k8s/ingress.yaml (Task 1 baseline), now templated and
+# configurable. cloudcrafter.local stays the default local-dev host.
+# ------------------------------------------------------------------------
+ingress:
+  enabled: true
+  className: nginx
+  host: cloudcrafter.local
+  annotations:
+    nginx.ingress.kubernetes.io/rewrite-target: /$2
+
+# ------------------------------------------------------------------------
+# JWT keys for the Users service. The chart NEVER creates a Secret
+# containing real key material — it only references one that must already
+# exist in the cluster (see README.md "Helm Deployment" -> step 1).
+# ------------------------------------------------------------------------
+jwt:
+  existingSecret: users-jwt-keys
+  privateKeyFilename: private.key
+  publicKeyFilename: public.key
+  mountPath: /etc/cloudcrafter/jwt
+
+# ------------------------------------------------------------------------
+# LocalStack S3 configuration used by the Tickets service (Task 1 event
+# flow). The bucket/endpoint/region are plain configuration, not secrets.
+# The access key/secret below are LocalStack's well-known, publicly
+# documented dummy credentials ("test"/"test") — they authenticate against
+# nothing and are meaningless outside a local LocalStack instance. They are
+# templated through a Secret (see templates/tickets-s3-secret.yaml) as good
+# practice for *how* credentials should flow into a container, but they are
+# NOT sensitive values. Real AWS credentials must never be put in this file
+# — for a real AWS account, override this via --set or a separate,
+# non-committed values file, the same way the JWT keys are handled.
+s3:
+  endpoint: "http://host.minikube.internal:4566"
+  bucket: "cloudcrafter-ticket-receipts"
+  region: "us-east-1"
+  accessKeyId: "test"
+  secretAccessKey: "test"
+
+# ------------------------------------------------------------------------
