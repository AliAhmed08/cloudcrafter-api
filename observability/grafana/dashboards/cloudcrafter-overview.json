{
  "title": "CloudCrafter — Service Overview",
  "uid": "cloudcrafter-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Request rate by service (req/s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus-datasource" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-datasource" },
          "expr": "sum by (instance) (rate(http_requests_total{app=\"cloudcrafter\"}[1m]))",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Error rate by service (5xx req/s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus-datasource" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-datasource" },
          "expr": "sum by (instance) (rate(http_requests_total{app=\"cloudcrafter\", status_code=~\"5..\"}[1m]))",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "P95 request duration by service",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus-datasource" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-datasource" },
          "expr": "histogram_quantile(0.95, sum by (le, instance) (rate(http_request_duration_seconds_bucket{app=\"cloudcrafter\"}[5m])))",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Total requests (last 15m)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus-datasource" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-datasource" },
          "expr": "sum(increase(http_requests_total{app=\"cloudcrafter\"}[15m]))"
        }
      ]
    },
    {
      "id": 5,
      "title": "Live logs — all four services",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki-datasource" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 16 },
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessages": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki-datasource" },
          "expr": "{app=~\"users|events|tickets|notifications\"}"
        }
      ]
    }
  ]
}
